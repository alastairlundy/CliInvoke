<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <Title>CliInvoke.Specializations</Title>
        <Authors>AlastairLundy</Authors>
        <Copyright>Copyright (c) 2024-2026 Alastair Lundy</Copyright>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageVersion>3.2.0-alpha.1</PackageVersion>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <RepositoryUrl>https://github.com/alastairlundy/CliInvoke</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>
#### Added
- Multi-targets `net10.0` and `net11.0`.

#### Changed
- XML documentation improvements in `DefaultShellMiddleware` and refreshed package metadata/description/tags.</PackageReleaseNotes>
        <Description>Shell middleware for CliInvoke. Run commands through PowerShell, CMD, or the user's default shell with UsePowerShell, UseCmd, and UseDefaultShell. Requires the CliInvoke package.</Description>
        <PackageIcon>icon.png</PackageIcon>
        <IsTrimmable>true</IsTrimmable>
        <PackageId>CliInvoke.Specializations</PackageId>
        <Product>CliInvoke.Specializations</Product>
        <AssemblyVersion>3.2.0.0</AssemblyVersion>
        <FileVersion>3.2.0.0</FileVersion>
        <PackageTags>shell, pipe, command-line, executable, wrapper, powershell, cmd, standard-input, standard-output, standard-error, input, output, error, arguments, invoke, process, invocation, execution, middleware, automation</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CliInvoke.Specializations.Tests"/>
    </ItemGroup>

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CliInvoke.Core\CliInvoke.Core.csproj"/>
        <ProjectReference Include="..\CliInvoke\CliInvoke.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="README.md">
            <PackagePath>README.md</PackagePath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Internal\Localizations\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Internal\Localizations\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\.assets\icon.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>icon.png</Link>
        </None>
    </ItemGroup>

</Project>
