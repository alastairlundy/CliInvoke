<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Title>CliInvoke</Title>
        <Authors>AlastairLundy</Authors>
        <Description>CliInvoke is a .NET Library for interacting with Command Line Interfaces, CliInvoke is a library for interacting with Command Line Interfaces and wrapping around executables.</Description>
        <Copyright>Copyright (c) Alastair Lundy 2024-2026</Copyright>
        <RepositoryUrl>https://github.com/alastairlundy/CliInvoke</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReleaseNotes>#### Added
* Windows command-line length check. When the assembled command line exceeds the Windows
  `CreateProcess` limit (~32,767 characters), you get an `ArgumentException` before the process
  starts instead of Win32 error 206. Skipped when `UseShellExecute` is enabled.

#### Fixed
* `ProcessTimeoutPolicy.Enabled = false` now means no timeout in all three waits instead of
  arming the kill timer anyway, and interrupt-task faults are always observed.
* `MiddlewareContext.Next` invokes only the next middleware and the rest of the chain, not the
  composed chain head, which previously caused unbounded recursion.
* `AddCliInvoke` registers `IProcessConfigurationBuilder` as a blank-builder factory. The old
  by-type mapping threw on every `GetService`.
* `IExternalProcess.StartAsync(configuration, ct)` honors `RedirectStandardInput` like the
  instance overloads. A configured writer with redirection disabled is a no-op in every path.
* `FromProcessStartInfo` accepts empty-string environment values as a valid way to clear a
  variable. Keys must be non-null and non-empty.</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageVersion>3.1.0</PackageVersion>
        <AssemblyVersion>3.1.0.0</AssemblyVersion>
        <PackageTags>shell, pipe, command-line, executable, wrapper, standard-input, standard-output, standard-error, input, output, error, arguments, invoke, process, processconfiguration,execution.</PackageTags>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageIcon>icon.png</PackageIcon>
        <IsTrimmable>true</IsTrimmable>
        <PackageId>CliInvoke</PackageId>
        <Product>CliInvoke</Product>
        <PolyEnsure>true</PolyEnsure>
        <FileVersion>3.1.0.0</FileVersion>
<!--
        <PolyArgumentExceptions>true</PolyArgumentExceptions>
-->
    </PropertyGroup>

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Squash_InternalNamespacesToKeep>CliInvoke</Squash_InternalNamespacesToKeep>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>CliInvoke.Tests</_Parameter1>
        </AssemblyAttribute>
        <!--
            Cross-package middleware consumption: CliInvoke.Specializations shell
            middleware must access internal rewriting helpers (ShellRewriter, enums,
            ArgumentTokenizer) and the derivation hook (ProcessConfigurationDerivation).
            Promotion to public rejected — no extensibility goal; a Specializations
            home impossible — no reference direction from Core. Justification per
            ADR-0001 (docs/adr/0001-ivt-minimization.md, Grant inventory:
            CliInvoke → CliInvoke.Specializations).
        -->
        <InternalsVisibleTo Include="CliInvoke.Specializations"/>
    </ItemGroup>

<!--    <ItemGroup>
        <PackageReference Include="DotExtensions"/>
       <PackageReference Include="Polyfill" PrivateAssets="all">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>-->

    <ItemGroup>
        <ProjectReference Include="..\CliInvoke.Core\CliInvoke.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory"/>
        <PackageReference Include="Polyfill" PrivateAssets="all"/>
        <PackageReference Include="Squash" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\README.md">
            <Link>README.md</Link>
            <PackagePath>README.md</PackagePath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Include="..\..\THIRD_PARTY_NOTICES.txt">
            <Link>THIRD_PARTY_NOTICES.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Internal\Localizations\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Internal\Localizations\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\.assets\icon.png">
            <Pack>True</Pack>
            <PackagePath>icon.png</PackagePath>
            <Link>icon.png</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Extensions\" />
    </ItemGroup>
</Project>
