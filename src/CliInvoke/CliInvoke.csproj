    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>CliInvoke.Tests</_Parameter1>
        </AssemblyAttribute>
        <!--
            Cross-package middleware consumption: CliInvoke.Specializations shell
            middleware must access internal rewriting helpers (ShellRewriter, enums,
            ArgumentTokenizer) and the derivation hook (ProcessConfigurationDerivation).
            Promotion to public rejected — no extensibility goal; a Specializations
            home impossible — no reference direction from Core. Justification per
            ADR-0001 (docs/adr/0001-ivt-minimization.md, Grant inventory:
            CliInvoke → CliInvoke.Specializations).
        -->
        <InternalsVisibleTo Include="CliInvoke.Specializations"/>
    </ItemGroup>

