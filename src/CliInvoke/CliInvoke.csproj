<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0;</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Title>CliInvoke</Title>
        <Authors>AlastairLundy</Authors>
        <Description>CliInvoke is a .NET Library for interacting with Command Line Interfaces, CliInvoke is a library for interacting with Command Line Interfaces and wrapping around executables.</Description>
        <Copyright>Copyright (c) Alastair Lundy 2024-2026</Copyright>
        <RepositoryUrl>https://github.com/alastairlundy/CliInvoke</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReleaseNotes>### 🐛 Bug Fixes
- Fixed `RunnerProcessFactory.CreateRunnerConfiguration` to chain `RequireAdministratorPrivileges()` on the existing builder instead of replacing it with a fresh one, preserving all accumulated configuration when admin privileges are required
- 🔒 Hardened shell argument escaping in `RunnerProcessFactory.CreateRunnerConfiguration`: the caller's `TargetFilePath` and `Arguments` are now escaped (cmd caret / PowerShell backtick) and the target path is quoted when wrapping through cmd/PowerShell, neutralising command-injection metacharacters</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageVersion>2.10.4</PackageVersion>
        <AssemblyVersion>2.10.4.0</AssemblyVersion>
        <PackageTags>shell, pipe, command-line, executable, wrapper, standard-input, standard-output, standard-error, input, output, error, arguments, invoke, process, processconfiguration,execution.</PackageTags>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageIcon>icon.png</PackageIcon>
        <IsTrimmable>true</IsTrimmable>
        <PackageId>CliInvoke</PackageId>
        <Product>CliInvoke</Product>
        <PolyEnsure>true</PolyEnsure>
        <PolyArgumentExceptions>true</PolyArgumentExceptions>
        <!-- Keep this project's polyfills internal and out of metadata (EmbeddedAttribute) so
             they do not leak into, or clash with, CliInvoke.Core's copy. -->
        <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
        <NoWarn>$(NoWarn);CS0618</NoWarn>
        <FileVersion>2.10.4.0</FileVersion>
    </PropertyGroup>
    
    <PropertyGroup Condition="$(TargetFramework) != 'netstandard2.0'">
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>CliInvoke.Tests</_Parameter1>
        </AssemblyAttribute>
        <InternalsVisibleTo Include="CliInvoke.Extensions"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Reference Polyfill directly (PrivateAssets=all) so the netstandard2.0 polyfills this
             assembly uses (OperatingSystem.IsX, Dictionary.TryAdd, Stream/Process helpers,
             SecureString, OS-platform attributes, ThrowIf* guards, Char/Encoding helpers) are
             compiled as its own private 'Polyfills.Polyfill'. CliInvoke.Core also references
             Polyfill but with PolyUseEmbeddedAttribute, so it does NOT leak its copy via IVT,
             avoiding the duplicate-definition (CS0433/CS0121) clashes. -->
        <PackageReference Include="Polyfill" PrivateAssets="all" />
        <PackageReference Include="DotExtensions" />
        <!-- Direct reference (netstandard2.0 only) so Polyfill's RefsBclMemory detection fires
             and it skips emitting its own System.Index/System.Range, which would otherwise clash
             with Microsoft.Bcl.Memory (a transitive dependency here). -->
        <PackageReference Include="Microsoft.Bcl.Memory" Condition="'$(TargetFramework)' == 'netstandard2.0'"/>
    </ItemGroup>

    <PropertyGroup>
        <!-- default false, CI can set to true -->
        <UsePublishedPackages Condition="'$(UsePublishedPackages)'==''">false</UsePublishedPackages>
    </PropertyGroup>

    <ItemGroup Condition="'$(UsePublishedPackages)'=='false'">
        <ProjectReference Include="..\CliInvoke.Core\CliInvoke.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UsePublishedPackages)'=='true'">
        <!-- set CliInvokeCoreVersion in the workflow -->
        <PackageReference Include="CliInvoke.Core" />
    </ItemGroup>
    
    <ItemGroup>
      <Content Include="..\..\README.md">
        <Link>README.md</Link>
          <PackagePath>README.md</PackagePath>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Include="..\..\THIRD_PARTY_NOTICES.txt">
        <Link>THIRD_PARTY_NOTICES.txt</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Update="Internal\Localizations\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="Internal\Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>
    
    <ItemGroup>
      <None Include="..\..\.assets\icon.png">
        <Pack>True</Pack>
        <PackagePath>icon.png</PackagePath>
        <Link>icon.png</Link>
      </None>
    </ItemGroup>
</Project>
