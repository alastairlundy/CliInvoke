<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <TargetFrameworks>net10.0;net8.0;net9.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Title>CliInvoke</Title>
        <Authors>AlastairLundy</Authors>
        <Description>CliInvoke is a .NET Library for interacting with Command Line Interfaces, CliInvoke is a library for interacting with Command Line Interfaces and wrapping around executables.</Description>
        <Copyright>Copyright (c) Alastair Lundy 2024-2026</Copyright>
        <RepositoryUrl>https://github.com/alastairlundy/CliInvoke</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReleaseNotes>
### Added
- New `ProcessControlAdapter` abstraction (`BaseProcessControlAdapter`, `WindowsProcessControlAdapter`, `UnixProcessControlAdapter`) to decouple OS-specific process control logic (suspend, resume, resource policy) from `ProcessWrapper`
- `ProcessControlAdapterFactory` for platform-specific adapter creation
- `src/global.json` pinning .NET SDK 10.0.0 with `latestMajor` roll-forward and prerelease support
- Re-enabled `Polyfill` NuGet package reference (was previously commented out)

### Changed
* Updated internal Polyfill version from 10.7.0 to 10.10.0
* Updated DotExtensions version from 10.3.2 to 10.3.3
- **Architecture rework**: `ProcessInvoker` and `CliRun` now delegate to `IExternalProcess` via `IExternalProcessFactory` instead of directly constructing and managing `ProcessWrapper` instances
- `ProcessWrapper` moved from `CliInvoke.Helpers` to `CliInvoke.Processes.Internal` namespace
- Process cancellation and piping code consolidated into the internal `ProcessWrapper`
- Cancellation helpers (`CancellationHelper`, `CancellationReason`) moved to `CliInvoke.Processes.Internal.Cancellation`
- `ExternalProcess.CaptureBufferedResultAsync` reworked to use `ProcessWrapper.ReadAllTextAsync` instead of separate `StandardOutput.ReadToEndAsync` / `StandardError.ReadToEndAsync` calls
- Enabled `GenerateDocumentationFile` globally in `Directory.Build.props`
- `ArgumentsBuilder`: replaced `var` with explicit `List&lt;string&gt;` / `List&lt;IFormattable&gt;` types for clarity
- Fixed trailing semicolon in `TargetFrameworks` (`net10.0;net8.0;net9.0;` → `net10.0;net8.0;net9.0`)

### Fixed
- **Process exit semaphore leak on Unix systems** — the cancellation semaphore was not being released in all exit paths
- Buffered output reading race condition in `ExternalProcess` by consolidating stdout/stderr reads into a single `ReadAllTextAsync` call

### Removed
- `CliInvoke.Helpers.ProcessWrapper` (replaced by `CliInvoke.Processes.Internal.ProcessWrapper`)
- `CliInvoke.Helpers.Processes.ProcessCancellationExtensions` (consolidated into internal `ProcessWrapper`)
- `CliInvoke.Helpers.Processes.ProcessPipingHelper` (consolidated into internal `ProcessWrapper`)
- `CliInvoke.Helpers.Processes.ToStartInfoExtensions` (moved to internal usage)
- `CliInvoke.Helpers.Processes.ApplyInfos.ApplyConfigurationToProcessStartInfo` (moved to `ProcessControlAdapters`)
- `CliInvoke.Helpers.Processes.ApplyInfos.ProcessSetPolicyExtensions` (moved to `ProcessControlAdapters`)
- `CliInvoke.Helpers.Processes.Cancellation.UnixGracefulCancellation` (consolidated into `UnixProcessControlAdapter`)
- `CliInvoke.Helpers.Processes.Cancellation.WindowsGracefulCancellation` (consolidated into `WindowsProcessControlAdapter`)</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageVersion>3.0.0-alpha.5</PackageVersion>
        <AssemblyVersion></AssemblyVersion>
        <PackageTags>shell, pipe, command-line, executable, wrapper, standard-input, standard-output, standard-error, input, output, error, arguments, invoke, process, processconfiguration,execution.</PackageTags>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageIcon>icon.png</PackageIcon>
        <IsTrimmable>true</IsTrimmable>
        <PackageId>CliInvoke</PackageId>
        <Product>CliInvoke</Product>
        <PolyEnsure>true</PolyEnsure>
<!--
        <PolyArgumentExceptions>true</PolyArgumentExceptions>
-->
    </PropertyGroup>

    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>CliInvoke.Tests</_Parameter1>
        </AssemblyAttribute>
        <InternalsVisibleTo Include="CliInvoke.Extensions"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DotExtensions"/>
       <PackageReference Include="Polyfill" PrivateAssets="all">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <!-- default false, CI can set to true -->
        <UsePublishedPackages Condition="'$(UsePublishedPackages)'==''">false</UsePublishedPackages>
    </PropertyGroup>

    <ItemGroup Condition="'$(UsePublishedPackages)'=='false'">
        <ProjectReference Include="..\CliInvoke.Core\CliInvoke.Core.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UsePublishedPackages)'=='true'">
        <!-- set CliInvokeCoreVersion in the workflow -->
        <PackageReference Include="CliInvoke.Core"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\README.md">
            <Link>README.md</Link>
            <PackagePath>README.md</PackagePath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <None Include="..\..\THIRD_PARTY_NOTICES.txt">
            <Link>THIRD_PARTY_NOTICES.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Internal\Localizations\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Internal\Localizations\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\.assets\icon.png">
            <Pack>True</Pack>
            <PackagePath>icon.png</PackagePath>
            <Link>icon.png</Link>
        </None>
    </ItemGroup>
</Project>
