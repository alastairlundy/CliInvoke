<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>CliInvokeBenchMockData</AssemblyName>
        <IsPackable>false</IsPackable>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>false</SelfContained>
        <PublishAot>false</PublishAot>
        <Title>CliInvokeBenchMockData</Title>
        <Authors>Alastair Lundy</Authors>
        <Description>A Simulation tool that generates mock data for the CliInvoke Benchmarks.</Description>
        <Copyright>Copyright (c) Alastair Lundy 2026</Copyright>
        <RepositoryUrl>https://github.com/alastairlundy/CliInvoke</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Company>Alastair Lundy</Company>
        <RootNamespace>CliInvoke.Benchmarking.MockDataSimTool</RootNamespace>
        <PackageId>CliInvokeBenchMockData</PackageId>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Bogus"/>
        <PackageReference Include="System.CommandLine"/>
    </ItemGroup>
</Project>
