# Use the default Lunet template (https://github.com/lunet-io/templates).
extend "lunet-io/templates"

template_theme_default_mode = "system"

# Project metadata - set these before calling site_project_init.
site_project_name = "MyLib"
site_project_description = "A minimal library for testing Lunet build timeouts."
site_project_baseurl = "https://example.github.io/mylib"
site_project_basepath = "/mylib"
site_project_github_user = "example"
site_project_github_repo = "mylib"
site_project_owner_name = "Example"
site_project_logo_path = "/img/favicon.ico"
site_project_favicon_path = "/img/favicon.ico"
site_project_owner_alias = "example"
site_project_content_license_name = "CC BY 4.0"
site_project_content_license_url = "https://creativecommons.org/licenses/by/4.0/"

with api.dotnet
  title = "MyLib API Reference"
  path = "/api"
  menu_name = "api"
  menu_title = "API Reference"
  config = "Release"
  properties = { TargetFramework: "net10.0" }
  projects = [
    { name: "MyLib", path: "../src/MyLib/MyLib.csproj" }
  ]
end

site_project_init
